if (!isset($_SERVER['argv'][1])) {
    throw new RuntimeException('No modification name specified');
}

$sName = $_SERVER['argv'][1];

if (empty($sName)) {
    throw new RuntimeException('Invalid modification name');
}

$sSource = sprintf('mods/%s.json', $sName);
$sTarget = sprintf('test/mods/%s.props', $sName);
$oBuilder = new GamePropertiesBuilder(
    'test/',
    $sSource,
    $sTarget
);

