#!/usr/bin/php
<?php

declare(strict_types=1);

namespace TKGD;

use stdClass;
use RuntimeException;

require 'src/Library.php';

class LevelPropertiesBuilder extends Data\Format\Builder {

    private const string SUBFORMAT_NAME = 'Level';
    private const string PVS_ERRATA_IDENT = 'PVSE';
    private const string BACKDROP_ERRATA_IDENT = 'BKDE';
    private const string ZONE_MESSAGE_IDENT = 'ZMSG';
    private const string OBJECT_MESSAGE_IDENT = 'OMSG';

    protected function getSubFormat(stdClass $oData): Data\Format\SubFormat {
        if (!isset($oData->DataType) || self::SUBFORMAT_NAME !== $oData->DataType) {
            throw new RuntimeException('Missing or unexpected DataType');
        }
        return Data\Format\SubFormat::Level;
    }

    protected function preprocess(
        Data\Format\Header $oHeader,
        stdClass $oData,
        Data\Format\StringBlob $oStringBlob
    ): void {
        printf(
            "Building %s ['%s' version: %d.%d, target: %d.%d]...\n",
            $this->sTargetPath,
            $oData->Header->Description ?? '<No Description>',
            $oHeader->oVersion->iMajor,
            $oHeader->oVersion->iMinor,
            $oHeader->oRequires->iMajor,
            $oHeader->oRequires->iMinor
        );
    }

    public function getChunks(stdClass $oData, Data\Format\StringBlob $oStringBlob): array {
        $aChunks = [];
        if (isset($oData->ZoneErrata->PVSDeletions)) {
            $aChunks[] = $this->buildZonePVSErrata($oData, $oStringBlob);
        }
        if (isset($oData->ZoneErrata->NoSkyVisible)) {
            $aChunks[] = $this->buildZoneBackropErrata($oData, $oStringBlob);
        }
        if (isset($oData->ZoneMessages)) {
            $aChunks[] = $this->buildZoneMessages($oData, $oStringBlob);
        }
        return $aChunks;
    }

    private function buildZonePVSErrata(
        stdClass $oData,
        Data\Format\StringBlob $oStringBlob
    ): Data\Format\Chunk {
        return new Data\Format\Chunk(
            self::PVS_ERRATA_IDENT,
            new class($oData->ZoneErrata->PVSDeletions) implements Data\Format\BinaryEncodable {
                public function __construct(private stdClass $aPVSErrata) {}
                public function toBinary(): string {
                    $sData = '';
                    foreach ($this->aPVSErrata as $iZoneID => $aRemoveZoneIDs) {
                        $aRemoveZoneIDs[] = -1;
                        $sData .= pack('nn*', $iZoneID, ...$aRemoveZoneIDs);
                    }
                    $sData .= pack('n', -1);
                    return $sData;
                }
            }
        );
    }

    private function buildZoneBackropErrata(
        stdClass $oData,
        Data\Format\StringBlob $oStringBlob
    ): Data\Format\Chunk {
        return new Data\Format\Chunk(
            self::BACKDROP_ERRATA_IDENT,
            new class($oData->ZoneErrata->NoSkyVisible) implements Data\Format\BinaryEncodable {
                public function __construct(private array $aBackdropErrata) {}
                public function toBinary(): string {
                    $this->aBackdropErrata[] = -1;
                    return pack('n*', ...$this->aBackdropErrata);
                }
            }
        );
    }


    private function buildZoneMessages(
        stdClass $oData,
        Data\Format\StringBlob $oStringBlob
    ): Data\Format\Chunk {
        return new Data\Format\Chunk(
            self::ZONE_MESSAGE_IDENT,
            new class($oData->ZoneMessages, $oStringBlob) implements Data\Format\BinaryEncodable {
                public function __construct(
                    private stdClass $aZoneMessages,
                    private Data\Format\StringBlob $oStringBlob
                ) {}

                public function toBinary(): string {
                    $aData = [];
                    foreach ($this->aZoneMessages as $iZoneID => $oInfo) {
                        $aData[] = $iZoneID << 16 | $oInfo->attr | strlen($oInfo->text);
                        $aData[] = $this->oStringBlob->add($oInfo->text);
                    }
                    // Terminate with a -1 zone reference
                    $aData[] = 0xFFFF0000;

                    return pack('N*', ...$aData);
                }
            }
        );
    }
}

if (!isset($_SERVER['argv'][1])) {
    throw new RuntimeException("No level specified");
}

$sLevel = strtoupper($_SERVER['argv'][1]);

if (!preg_match('/^[A-P]$/', $sLevel)) {
    throw new RuntimeException('Invalid Level ID ' . $sLevel);
}

$sSource = sprintf('levels/level_%s.rson', $sLevel);
$sTarget = sprintf('test/levels/level_%s.props', $sLevel);
$oBuilder = new LevelPropertiesBuilder(
    'test/',
    $sSource,
    $sTarget
);

$oBuilder->build();

