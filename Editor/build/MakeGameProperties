#!/usr/bin/php
<?php

declare(strict_types=1);

namespace TKG;

use stdClass;
use RuntimeException;

require 'src/bootstrap.php';

$sName = $_SERVER['argv'][1];

if (empty($sName)) {
    throw new RuntimeException('Invalid modification name');
}

$sSource = sprintf('mods/%s.rson', $sName);
$sTarget = sprintf('test/mods/%s.props', $sName);
$oBuilder = new Mod\File\GameProperties\Builder(
    'test/',
    $sSource,
    $sTarget
);

$oBuilder->build();

