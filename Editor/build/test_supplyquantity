#!/usr/bin/php
<?php

declare(strict_types=1);

namespace TKG;

use stdClass;
use RuntimeException;

require 'src/bootstrap.php';

const DEF_HEALTH = 0x1234;
const DEF_FUEL   = 0x4321;

const NORMAL_TYPES = [
    "Type1" => 1,
    "Type2" => 4,
    "Type3" => 6,
    "Type4" => 8,
];

const SPECIAL_TYPES = [
    "Spec1" => 2,
    "Spec2" => 3,
    "Spec3" => 5,
    "Spec4" => 7,
];

$aTestCases = [
    "\x01\x00" . // Health.w
    "\x00\x10" . // Fuel.w
    "\xFF\xFF" => (object)[
        "Health" => 0x100,
        "Fuel"   => 0x10
    ],
    "\x01\x01" . // Health.w
    "\x00\x11" . // Fuel.w
    "\x00\x01" . // Ammo[0].Type.w
    "\x00\x0A" . // Ammo[0].Count.w
    "\xFF\xFF" => (object)[
        "Health" => 0x101,
        "Fuel"   => 0x11,
        "Ammo" => [
            "Type1" => 10
        ]
    ],
    "\x01\x02" . // Health.w
    "\x00\x12" . // Fuel.w
    "\x00\x04" . // Ammo[0].Type.w
    "\x00\x0F" . // Ammo[0].Count.w
    "\x00\x02" . // Ammo[1].Type.w
    "\x00\x11" . // Ammo[1].Count.w
    "\xFF\xFF" => (object)[
        "Health" => 0x102,
        "Fuel"   => 0x12,
        "Ammo" => [
            "Type2" => 15,
            "Spec1" => 17
        ]
    ],
];

$i = 0;
foreach ($aTestCases as $sExpected => $oData) {
    try {
        $sGot = (
            new Mod\File\GameProperties\SupplyQuantity(
                $oData,
                DEF_HEALTH,
                DEF_FUEL,
                NORMAL_TYPES,
                SPECIAL_TYPES
            )
        )->toBinary();

    } catch (\Exception $oError) {
        $sGot = '';
    }
    if ($sExpected !== $sGot) {
        printf(
            "Test Case %d Failed, Expected %s, Got %s\n",
            $i,
            bin2hex($sExpected),
            bin2hex($sGot)
        );
    } else {
        printf(
            "Test Case %d Passed\n",
            $i
        );
    }
    ++$i;
}
