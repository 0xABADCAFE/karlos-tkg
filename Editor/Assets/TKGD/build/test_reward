declare(strict_types=1);

namespace TKG;

use stdClass;
use RuntimeException;

require 'src/bootstrap.php';

$sRSON = "{
    Description: \"Found Bandolier. Increased ammo carry.\",
    CarryLimitAdd: {
        //Health: 1,
        //Fuel: 3,
        Ammo: {
            \"Bullet\": 5,
            \"Shot\": 7
