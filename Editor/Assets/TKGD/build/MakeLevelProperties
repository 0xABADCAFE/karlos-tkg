#!/usr/bin/php
<?php

declare(strict_types=1);

namespace TKG;
use stdClass;
use RuntimeException;

$aOpts = getopt('b:f:t:');
$sBase = $aOpts['b'] ?? throw new RuntimeException('Missing base location. Use -b<path to source base>');
$sFrom = $aOpts['f'] ?? throw new RuntimeException('Missing from location. Use -f<path to source file>');
$sTo   = $aOpts['t'] ?? throw new RuntimeException('Missing target location. Use -t<path to target file>');

require 'src/bootstrap.php';

$oBuilder = new Mod\File\LevelProperties\Builder(
    $sBase,
    $sFrom,
    $sTo
);

$oBuilder->build();

