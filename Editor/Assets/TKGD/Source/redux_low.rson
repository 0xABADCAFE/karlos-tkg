{
    Header: {
        DataType: "Game",
        Requires: "1.2",
        Version: "1.0",
        Description: "AB3DII-TKG Redux:\n"
                     "OCD Special Edition, Low Spec."
    },
    Target: "LowSpec/Includes/game_mod.tkgd",
    Import: {
        // Definitions become acessible as Import->LinkDefs->...
        LinkDefs: "common/linkdefs.rson",
    },
    DefaultInventoryLimits: {
        // When starting a new game, these are the maximum carry limits for each class of collectable.
        // These can be increased by completing various achievements or collectint special ammo types.
        MaxHealth: 300,
        MaxJetpackFuel: 250,
        MaxAmmo: {
            "Blaster": 60,
            "Shot": 40,
            "Grenade": 12,
            "Bullet": 240,
            "Plasma": 100,
            "Rocket": 6,
            "ChargedPlasma": 10,
            "Mine": 5,
            "Bouncer": 30,
            "Bandolier": 1,
            "Backpack": 1,
        },
    },
    SpecialAmmoBonuses: {
        // Reward definitions for collecting each type of special ammo.
        "Bandolier": {
            Description: "Found Bandolier. Increased ammo carry.",
            CarryLimitAdd: {
                Ammo: {
                    "Bullet": 200,
                    "Shot": 40,
                }
            }
        },
        "Backpack": {
            Description: "Found Backpack. Increased explosives carry.",
            CarryLimitAdd: {
                Ammo: {
                    "Grenade": 12,
                    "Rocket": 6,
                }
            }
        },
    },
    WeaponAdjustments: {
        "RocketLauncher": {
            SpawnOffset: [10, -10],  // Shift to the right and down slightly
            Recoil: 10,              // Fairly big kick

            // Weapon is too slow firing to have any spray or cooldown
            // and too chonky to use just anywhere.

            NoRun: true,             // Too big to run with.
            NoCrouch: true,          // Too big to crouch with.
            NoFly: true,             // Too big to fly with.
            NoFireSubmerged: true    // You'd be suicidal to try.
        }
    },
    Achievements: [
